# Production settings. Copy to /srv/software-factory/.env and fill in the blanks.
# See docs/DEPLOY.md.

APP_NAME="Software Factory"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://factory.example.com
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=software_factory
DB_USERNAME=software_factory
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Password resets and team invitations are sent by email.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="factory@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# The proxy in front of the app (Caddy on the same machine).
TRUSTED_PROXIES=127.0.0.1,::1

# Agent runner: one Docker container per run.
FACTORY_RUNNER_DRIVER=docker
FACTORY_DOCKER_IMAGE=software-factory-runner:latest
FACTORY_DOCKER_MEMORY=4g
FACTORY_DOCKER_CPUS=2
FACTORY_WORKSPACE_PATH=/srv/software-factory-workspaces
FACTORY_RUN_TIMEOUT=3600
FACTORY_PARALLEL_RUNS=2
FACTORY_MAX_BUDGET_USD=10
SPECIFY_BIN=/home/factory/.local/bin/specify
GIT_BIN=git

# Pull requests
FACTORY_MERGE_METHOD=squash
FACTORY_PR_SYNC_MINUTES=5

# Backups (daily). Set FACTORY_BACKUP_DISK=s3 and the AWS_* values for an off-site copy.
FACTORY_BACKUP_KEEP_DAYS=14
FACTORY_BACKUP_DISK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

VITE_APP_NAME="${APP_NAME}"
